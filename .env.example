# AI провайдер: openrouter или deepseek
AI_PROVIDER=openrouter

# OpenRouter
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=openai/gpt-4o-mini

# DeepSeek
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat

# Сервер
PORT=8000

# Путь к данным (внутри контейнера)
DATA_PATH=./data

# Obsidian vault (на VM; в Docker обычно /app/vault)
OBSIDIAN_ENABLED=false
OBSIDIAN_VAULT_PATH=./obsidian-vault
VAULT_AUTO_LOG_CHATS=false
VAULT_AI_FOLDER=AI-Generated
VAULT_ARTIFACT_AUTOSAVE_THRESHOLD=0.67
VAULT_AUTOSAVE_MODE=structured
VAULT_RETRIEVAL_MAX_FILES=6
VAULT_RETRIEVAL_MAX_SECTIONS=12
VAULT_RETRIEVAL_MAX_CHARS=32000

# WebDAV (bytemark/webdav) для синхронизации Obsidian (Remotely Save)
WEBDAV_PORT=8081
WEBDAV_USER=obsidian
WEBDAV_PASSWORD=


# Optional Basic Auth
AUTH_ENABLED=false
AUTH_USERNAME=admin
AUTH_PASSWORD=

# CORS
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
